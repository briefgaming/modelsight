# Copy this file to .env and fill in the values. .env is not committed.
#
# Local runs: `ms` loads .env from the directory you run it in, and the server
# and bench processes inherit these variables. A variable already set in your
# shell is kept.
#
# Modal runs: the container does not receive this file. Put the same token in
# a Modal secret named "huggingface":
#   modal secret create huggingface HF_TOKEN=$HF_TOKEN

# Hugging Face token for gated or private model downloads.
HF_TOKEN=
